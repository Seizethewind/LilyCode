<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>
    <application
        android:label="Lily Code"
        android:theme="@style/Theme.LilyCode">
        <!-- singleTask: `lily <file>` from Termux reaches onNewIntent. configChanges: rotation must not drop open tabs. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".data.RunResultReceiver" android:exported="false" />
    </application>
</manifest>
